@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using TestMaker.Data.Models
@using FieldType = TestMaker.Data.Models.FieldType

<MudText Typo="Typo.h6" Color="Color.Tertiary">Answers:</MudText>
<MudRadioGroup @bind-Value="Question.CorrectAnswer" T="CorrectAnswer">
    @foreach (var answer in Question.Answers)
    {
        <div class="d-flex my-2 align-items-baseline">
            <div>
                <MudRadio Value="@(answer.AnswerValue)">
                    @if (!Editing)
                    {
                        @if (answer.Answer.Type == FieldType.Text)
                        {
                            @answer.Answer.Value
                        }
                        else
                        {
                            <MudImage Src="@answer.Answer.Value"/>
                        }
                    }
                </MudRadio>
            </div>
            @if (Editing)
            {
                @if (answer.Answer.Type == FieldType.Text)
                {
                    <MudTextField @bind-Value="answer.Answer.Value"
                                  Label="Provide answer" Clearable FullWidth/>
                }
                else
                {
                    <MudFileUpload
                        T="IBrowserFile"
                        Accept="@PhotoAcceptExtensions"
                        FilesChanged="args =>  ChangePhoto(args, answer.Id, Question)"
                    >
                        <ActivatorContent>
                            @if (answer.Answer.Value != string.Empty)
                            {
                                <MudTooltip Text="Click to change file" Arrow="true" Placement="Placement.Top">
                                    <MudImage Src="@answer.Answer.Value"/>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    Change file
                                </MudButton>
                            }
                        </ActivatorContent>
                    </MudFileUpload>
                }

                <MudButton Color="Color.Warning"
                           StartIcon="@(answer.Answer.Type == FieldType.Text ? Icons.Material.Filled.Camera : Icons.Material.Filled.FontDownload)"
                           OnClick="() => ChangeType(answer.Answer)">Switch type
                </MudButton>
                <MudButton Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="() => DeleteAnswer(answer.Id)">DELETE
                </MudButton>
            }
        </div>
    }
</MudRadioGroup>

@code
{
    [Parameter] public TestOneQuestion Question { get; set; } = null!;
    [Parameter] public bool Editing { get; set; }
    [Parameter] public string PhotoAcceptExtensions { get; set; } = string.Empty;
    [Parameter] public Action<Field> ChangeType { get; set; } = null!;
    [Parameter] public Func<Guid, Task> DeleteAnswer { get; set; } = null!;
    [Parameter] public Func<IBrowserFile?, Guid, TestQuestion, Task> ChangePhoto { get; set; } = null!;
}