@using CommunityToolkit.Mvvm.Messaging
@using MudBlazor
@using TestMaker.Data.Messages
@using TestMaker.Data.Models
@using TestMaker.Data.Services
@implements IDisposable
<MudDialog>
    <TitleContent>
        Load photos after loading from Markdown
    </TitleContent>
    <DialogContent>
        @foreach (var question in Answers)
        {
            <MudText>@question.QuestionText</MudText>
            @if (question.PhotoData != string.Empty)
            {
                <MudImage Src="@question.PhotoData"></MudImage>
            }

            <MudButton OnClick="() => SendRequest(question.TestAnswerId)">Load file</MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success" OnClick="() => ApplyImages()">Apply images</MudButton>
        <MudButton Color="Color.Primary" OnClick="() => ApplyImagesAndClose()">Apply images and close</MudButton>
        <MudButton Color="Color.Error" OnClick="() => MudDialog.Close()">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [Inject] ISnackbar Snackbar { get; set; }
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; }
    [Parameter] public IMessenger Messenger { get; set; }
    [Parameter] public List<LoadPhotoRecord> Answers { get; set; }
    [Parameter] public ProjectService ProjectService { get; set; }
    [Parameter] public Project Project { get; set; }

    protected override void OnInitialized()
    {
        Messenger.Register<LoadPhotoToAnswerResponse>(this, (_, message) =>
        {
            var answer = Answers.FirstOrDefault(t => t.TestAnswerId == message.AnswerId);
            if (answer is null)
            {
                Snackbar.Add("Cannot find answer", Severity.Error);
                return;
            }

            var index = Answers.IndexOf(answer);
            Answers.Remove(answer);
            Answers.Insert(index, new LoadPhotoRecord(answer.QuestionText, message.AnswerId, message.PhotoBase64Data));
            StateHasChanged();
        });
    }

    public void ApplyImagesAndClose()
    {
        ApplyImages();
        Dispose();
        MudDialog.Close();
    }

    public void ApplyImages()
    {
        foreach (var (questionText, answerId, photoData) in Answers)
        {
            try
            {
                ProjectService.UpdateQuestionPhotoData(Project, answerId, photoData);
            }
            catch (Exception)
            {
                Snackbar.Add($"Could not set image to answer from question: {questionText}", Severity.Error);
            }
        }
    }

    public void SendRequest(Guid answerId)
    {
        Messenger.Send(new LoadPhotoToAnswerRequest
        {
            AnswerId = answerId
        });
    }

    public void Dispose()
    {
        Messenger.Unregister<LoadPhotoToAnswerResponse>(this);
    }
}